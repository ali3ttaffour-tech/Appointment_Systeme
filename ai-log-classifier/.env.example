# Copy to .env and adjust. Never commit a real .env file.

AI_SERVICE_NAME=ai-log-classifier
AI_SERVICE_PORT=8000
LOG_LEVEL=INFO

MODEL_PATH=/app/model
MODEL_VERSION=

CONFIDENCE_ACCEPT_THRESHOLD=0.80
CONFIDENCE_WARN_THRESHOLD=0.50

MAX_LOG_LENGTH=4000
MAX_BATCH_SIZE=200

RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=300

ALERT_WINDOW_SECONDS=300
ALERT_SECURITY_ALERT_COUNT=10
ALERT_DATABASE_ERROR_COUNT=15
ALERT_AUTH_ERROR_COUNT=10
ALERT_APPLICATION_ERROR_COUNT=20
ALERT_WEBHOOK_URL=
